---
import EmptyState from '@/components/EmptyState.astro';
import PortfolioGallery from '@/components/portfolio/PortfolioGallery.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { SITE } from '@/config/site';
import { getPublishedPortfolio } from '@/domain/portfolio.server';
import { PUBLIC_ROUTES } from '@/domain/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/portfolio.css';

const series = await getPublishedPortfolio();
---

<BaseLayout title="作品 | zhou" description="经确认可公开的视觉与媒体作品。" canonicalPath="/portfolio/" seoKind="list">
  <SiteHeader slot="header" />
  <section class="portfolio-page" aria-labelledby="portfolio-heading">
    <header class="portfolio-page__header">
      <p class="portfolio-page__eyebrow">作品</p>
      <h1 id="portfolio-heading">作品</h1>
      <p>这里仅呈现已确认授权、可公开验证的视觉与媒体记录。</p>
      <div class="portfolio-page__actions" aria-label="作品页面操作">
        <a
          class="portfolio-page__button portfolio-page__button--primary"
          data-portfolio-primary-cta
          href={SITE.githubUrl}
          rel="me external">访问 GitHub</a
        >
        <a class="portfolio-page__button" data-portfolio-secondary-cta href={PUBLIC_ROUTES.projects}>查看项目</a>
      </div>
    </header>
    {
      series.length ? (
        <PortfolioGallery series={series} />
      ) : (
        <EmptyState
          collection="portfolio"
          title="暂无可公开的作品媒体"
          description="确认授权与公开范围后，才会在这里呈现。"
        />
      )
    }
  </section>
</BaseLayout>
