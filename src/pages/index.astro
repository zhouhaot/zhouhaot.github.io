---
import CapabilityMap from '@/components/home/CapabilityMap.astro';
import CurrentStatus from '@/components/home/CurrentStatus.astro';
import DeliveryMethod from '@/components/home/DeliveryMethod.astro';
import FeaturedProjects from '@/components/home/FeaturedProjects.astro';
import Hero from '@/components/home/Hero.astro';
import LatestArticles from '@/components/home/LatestArticles.astro';
import { getPublishedEntries } from '@/domain/content';
import { getSiteProfile } from '@/domain/public-profile.server';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/home.css';

const [profile, works, notes] = await Promise.all([
  getSiteProfile(),
  getPublishedEntries('works'),
  getPublishedEntries('notes'),
]);
const primaryContact = profile.contacts[0];
if (!primaryContact) throw new Error('Site profile requires a primary public contact.');

const featuredWorks = works.filter((entry) => entry.data.featured).slice(0, 3);
const recentNotes = notes.slice(0, 3);
---

<BaseLayout>
  <div class="home-page">
    <div class="home-grid home-grid--hero">
      <Hero
        eyebrow={profile.heroEyebrow}
        title={profile.heroTitle}
        role={profile.role}
        summary={profile.heroSummary}
        primaryContact={primaryContact}
      />
      <FeaturedProjects entries={featuredWorks} />
    </div>
    <div class="home-grid home-grid--capabilities">
      <CapabilityMap capabilities={profile.capabilities} />
      <DeliveryMethod steps={profile.method} />
    </div>
    <div class="home-grid home-grid--footer">
      <LatestArticles entries={recentNotes} />
      <CurrentStatus currentStatus={profile.currentStatus} primaryContact={primaryContact} />
    </div>
  </div>
</BaseLayout>
