---
import EmptyState from '@/components/EmptyState.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import ProjectFilters from '@/components/projects/ProjectFilters.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { getPublishedProjects } from '@/domain/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/projects.css';

const projects = await getPublishedProjects();
---

<BaseLayout title="项目 | zhou" description="可验证的项目与实验。" canonicalPath="/projects/">
  <SiteHeader slot="header" />
  <section class="projects-page" aria-labelledby="projects-heading">
    <header class="projects-page__header">
      <p class="projects-page__eyebrow">Projects</p>
      <h1 id="projects-heading">项目</h1>
      <p>正式项目与实验共享发现界面，并保持各自真实、清晰的叙事边界。</p>
    </header>
    {
      projects.length ? (
        <>
          <ProjectFilters projects={projects}>
            <div class="projects-grid">
              {projects.map((project) => <ProjectCard project={project} />)}
            </div>
          </ProjectFilters>
          <script>
            import { initProjectFilters } from '@/scripts/project-filters';

            initProjectFilters();
          </script>
        </>
      ) : (
        <EmptyState collection="projects" title="项目正在整理中" description="确认可公开的项目或实验后，会在这里呈现。" />
      )
    }
  </section>
</BaseLayout>
