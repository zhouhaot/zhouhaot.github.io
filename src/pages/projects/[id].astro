---
import ProjectDetail from '@/components/projects/ProjectDetail.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { getPublishedProjects, projectStaticPaths, type PublicProject } from '@/domain/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/projects.css';

export async function getStaticPaths() {
  return projectStaticPaths(await getPublishedProjects());
}

interface Props {
  project: PublicProject;
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} | zhou`} description={project.summary} canonicalPath={project.href}>
  <SiteHeader slot="header" />
  <ProjectDetail project={project} />
</BaseLayout>
