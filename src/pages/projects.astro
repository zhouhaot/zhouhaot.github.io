---
import { getCollection } from "astro:content";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<MainGridLayout title="作品" description="个人作品与实验项目">
	<div class="flex flex-col gap-4">
		{
			projects.map((project) => {
				const { data } = project;
				return (
					<div class="card-base rounded-[var(--radius-large)] p-6 hover:translate-y-[-2px] transition-transform duration-200">
						<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
							<h2 class="text-2xl font-bold text-[var(--primary)]">{data.title}</h2>
							{data.year && (
								<span class="text-sm text-black/30 dark:text-white/30">{data.year}</span>
							)}
							{data.status && (
								<span class="text-sm rounded-full px-2 py-0.5 bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
									{data.status}
								</span>
							)}
						</div>
						{data.description && (
							<p class="mt-2 text-black/70 dark:text-white/70">{data.description}</p>
						)}
						{data.tech.length > 0 && (
							<div class="mt-3 flex flex-wrap gap-2">
								{data.tech.map((t) => (
									<span class="text-xs rounded-md px-2 py-0.5 bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
										{t}
									</span>
								))}
							</div>
						)}
						<div class="mt-4 flex gap-4 text-sm">
							{data.demo && (
								<a
									href={data.demo}
									target="_blank"
									rel="noopener noreferrer"
									class="link text-[var(--primary)]"
								>
									在线演示 ↗
								</a>
							)}
							{data.link && (
								<a
									href={data.link}
									target="_blank"
									rel="noopener noreferrer"
									class="link text-[var(--primary)]"
								>
									源码 ↗
								</a>
							)}
						</div>
					</div>
				);
			})
		}
	</div>
</MainGridLayout>
