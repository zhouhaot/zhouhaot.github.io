---
import { getSiteProfile } from '@/domain/public-profile.server';
import { PUBLIC_ROUTES } from '@/domain/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/about.css';

const profile = await getSiteProfile();
const primaryContact = profile.contacts[0];
if (!primaryContact) throw new Error('Site profile requires a primary public contact.');
---

<BaseLayout title="关于 | zhou" description="匿名的 AI 应用开发职业资料。" canonicalPath="/about/" seoKind="about">
  <article class="about-page" aria-labelledby="about-heading">
    <header class="about-page__header" data-about-section="positioning">
      <p class="about-page__symbol" aria-hidden="true">zhou</p>
      <h1 id="about-heading">关于</h1>
      <p>{profile.positioning}</p>
    </header>
    <section data-about-section="capabilities" aria-labelledby="about-capabilities">
      <h2 id="about-capabilities">能力范围</h2><ul>
        {profile.capabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </section>
    <section data-about-section="method" aria-labelledby="about-method">
      <h2 id="about-method">工作方法</h2><ol>{profile.method.map((step) => <li>{step}</li>)}</ol>
    </section>
    <section data-about-section="principles" aria-labelledby="about-principles">
      <h2 id="about-principles">原则</h2><ul>{profile.principles.map((principle) => <li>{principle}</li>)}</ul>
    </section>
    <section data-about-section="current-status" aria-labelledby="about-current-status">
      <h2 id="about-current-status">当前状态</h2><p>{profile.currentStatus}</p>
    </section>
    <section data-about-section="trust-boundary" aria-labelledby="about-trust-boundary">
      <h2 id="about-trust-boundary">公开边界</h2><p>{profile.trustBoundary}</p>
    </section>
    <nav class="about-page__actions" aria-label="关于页面操作">
      <a
        class="about-page__button about-page__button--primary"
        data-about-primary-cta
        href={primaryContact.href}
        rel="me external">{primaryContact.label}</a
      >
      <a class="about-page__button" data-about-secondary-cta href={PUBLIC_ROUTES.projects}>查看项目</a>
    </nav>
  </article>
</BaseLayout>
