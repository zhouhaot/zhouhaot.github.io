---
import ArticleDiscovery from '@/components/articles/ArticleDiscovery.astro';
import EmptyState from '@/components/EmptyState.astro';
import { articleTagsFor } from '@/domain/articles';
import { getPublishedArticles } from '@/domain/articles.server';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/articles.css';

const articles = await getPublishedArticles();
---

<BaseLayout title="博客 | zhou" description="技术文章与经验积累。" canonicalPath="/blog/" seoKind="list">
  <section class="articles-page" aria-labelledby="blog-heading">
    <header><h1 id="blog-heading">博客</h1><p>技术文章与经验积累。</p></header>
    {
      articles.length ? (
        <>
          <ArticleDiscovery articles={articles} tags={articleTagsFor(articles)} />
          <script>import {initArticleDiscovery} from '@/scripts/articles'; initArticleDiscovery();</script>
        </>
      ) : (
        <EmptyState collection="notes" title="暂无公开文章" description="已确认可公开的笔记会在这里呈现。" />
      )
    }
  </section>
</BaseLayout>
