---
import ArticleDiscovery from '@/components/articles/ArticleDiscovery.astro';
import EmptyState from '@/components/EmptyState.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { articleTagsFor } from '@/domain/articles';
import { getPublishedArticles } from '@/domain/articles.server';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/articles.css';

const articles = await getPublishedArticles();
---

<BaseLayout title="文章 | zhou" description="公开技术笔记和文章。" canonicalPath="/articles/">
  <SiteHeader slot="header" />
  <section class="articles-page" aria-labelledby="articles-heading">
    <header><h1 id="articles-heading">文章</h1><p>公开技术笔记和文章。</p></header>
    {articles.length ? <><ArticleDiscovery articles={articles} tags={articleTagsFor(articles)} /><script>import { initArticleDiscovery } from '@/scripts/articles'; initArticleDiscovery();</script></> : <EmptyState collection="notes" title="暂无公开文章" description="已确认可公开的笔记会在这里呈现。" />}
  </section>
</BaseLayout>
