---
import { projectSectionId, type PublicProject } from '@/domain/projects';

interface Props {
  project: PublicProject;
}

const { project } = Astro.props;
---

<article class="project-detail">
  <a class="project-detail__back" href="/projects/">返回项目列表</a>
  <header class="project-detail__header">
    <div class="project-detail__meta" aria-label="项目元数据">
      <span>{project.kindLabel}</span>
      <span>{project.statusLabel}</span>
      <time datetime={project.publishedAt.toISOString()}>{project.year}</time>
    </div>
    <h1>{project.title}</h1>
    <p>{project.summary}</p>
    <dl class="project-detail__facts">
      {
        project.kind === 'work' && (
          <>
            <>
              <dt>职责</dt>
              <dd>{project.role}</dd>
            </>
          </>
        )
      }
      <dt>{project.kind === 'lab' ? '实验工具' : '技术栈'}</dt>
      <dd>{project.tools.join(' · ')}</dd>
      <dt>状态</dt>
      <dd>{project.statusLabel}</dd>
    </dl>
    {
      (project.repositoryUrl || project.demoUrl) && (
        <p class="project-detail__links">
          {project.repositoryUrl && (
            <a href={project.repositoryUrl} rel="external">
              GitHub
            </a>
          )}
          {project.demoUrl && (
            <a href={project.demoUrl} rel="external">
              在线体验
            </a>
          )}
        </p>
      )
    }
  </header>
  <div class="project-detail__sections">
    {
      project.detailSections.map((detail) => (
        <section aria-labelledby={projectSectionId(project.id, detail.key)}>
          <h2 id={projectSectionId(project.id, detail.key)}>{detail.title}</h2>
          {Array.isArray(detail.content) ? (
            <ul>
              {detail.content.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>{detail.content}</p>
          )}
        </section>
      ))
    }
  </div>
</article>
