---
import type { PublicProject } from '@/domain/projects';

interface Props {
  projects: PublicProject[];
}

const { projects } = Astro.props;
const statuses = [...new Map(projects.map((project) => [project.status, project.statusLabel])).entries()];
const years = [...new Set(projects.map((project) => project.year))].sort((left, right) => right.localeCompare(left));
---

<section class="project-filters" data-project-filters aria-label="项目筛选">
  <div class="project-filters__types" role="group" aria-label="项目类型">
    <span class="project-filters__label">类型</span>
    <button type="button" data-project-type="all" aria-pressed="true">全部</button>
    <button type="button" data-project-type="work" aria-pressed="false">项目</button>
    <button type="button" data-project-type="lab" aria-pressed="false">实验</button>
  </div>
  <label class="project-filters__select">
    <span>状态</span>
    <select data-project-status>
      <option value="all">全部状态</option>
      {statuses.map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
  </label>
  <label class="project-filters__select">
    <span>年份</span>
    <select data-project-year>
      <option value="all">全部年份</option>
      {years.map((year) => <option value={year}>{year}</option>)}
    </select>
  </label>
  <button class="project-filters__reset" type="button" data-project-reset>重置</button>
  <p class="project-filters__count" data-project-result-count aria-live="polite"></p>
  <p class="project-filters__empty" data-project-no-results aria-live="polite" hidden>没有匹配的项目，请调整筛选条件。</p>
  <slot />
</section>
