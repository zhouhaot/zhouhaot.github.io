---
import type { PublicPortfolioSeries } from '@/domain/portfolio';

interface Props {
  series: PublicPortfolioSeries[];
}

const { series } = Astro.props;
const galleryItems = series.flatMap((entry) => entry.items);
---

<div class="portfolio-series-list" data-portfolio-gallery>
  {
    series.map((entry) => (
      <section class="portfolio-series" aria-labelledby={`portfolio-${entry.id}`}>
        <header class="portfolio-series__header">
          <p>作品系列</p>
          <h2 id={`portfolio-${entry.id}`}>{entry.title}</h2>
          <p>{entry.summary}</p>
          {entry.relatedProject && <a href={entry.relatedProject.href}>查看关联项目：{entry.relatedProject.title}</a>}
        </header>
        <div class="portfolio-series__media">
          {entry.items.map((item) => (
            <figure>
              {item.type === 'image' ? (
                <img
                  data-portfolio-media
                  data-license={item.license}
                  data-credit={item.credit}
                  data-license-url={item.licenseUrl}
                  data-evidence-url={item.evidenceUrl}
                  src={item.asset.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <video
                  data-portfolio-media
                  data-license={item.license}
                  data-credit={item.credit}
                  data-license-url={item.licenseUrl}
                  data-evidence-url={item.evidenceUrl}
                  src={item.asset.src}
                  poster={item.posterAsset?.src}
                  width={item.width}
                  height={item.height}
                  controls
                  preload="none"
                />
              )}
              <figcaption>
                <p>{item.caption}</p>
                {item.credit && <p>{item.credit}</p>}
                {item.licenseUrl && <a href={item.licenseUrl}>许可说明</a>}
                {item.evidenceUrl && <a href={item.evidenceUrl}>来源说明</a>}
                <p>许可：{item.license}</p>
              </figcaption>
              <button
                type="button"
                data-lightbox-trigger
                data-lightbox-index={galleryItems.indexOf(item)}
                aria-label={`查看${item.alt || item.caption}`}
              >
                查看媒体
              </button>
            </figure>
          ))}
        </div>
      </section>
    ))
  }
  <template data-lightbox-items>
    {
      galleryItems.map((item) => (
        <figure
          data-lightbox-item
          data-type={item.type}
          data-src={item.asset.src}
          data-poster={item.posterAsset?.src}
          data-alt={item.alt}
          data-caption={item.caption}
          data-license={item.license}
          data-credit={item.credit}
          data-license-url={item.licenseUrl}
          data-evidence-url={item.evidenceUrl}
        />
      ))
    }
  </template>
</div>

<script>
  import { initPortfolioLightboxes } from '@/scripts/lightbox';

  initPortfolioLightboxes(document.body);
</script>
