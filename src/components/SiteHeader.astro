---
import { SITE } from '@/config/site';
---

<header class="site-header">
  <nav class="site-header__inner" aria-label="主导航">
    <a class="site-wordmark" href="/" aria-label="zhou 首页">zhou</a>
    <ul class="site-header__links">
      {SITE.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <a class="site-header__github" href={SITE.githubUrl} rel="me external">GitHub</a>
  </nav>
</header>
