---
import { SITE } from '@/config/site';
import { isCurrentNavigationRoute } from '@/scripts/navigation';
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<div class="mobile-drawer__overlay" data-drawer-overlay hidden></div>
<aside
  id="mobile-drawer"
  class="mobile-drawer"
  data-mobile-drawer
  role="dialog"
  aria-modal="true"
  aria-label="移动端导航"
  aria-hidden="true"
  inert
>
  <div class="mobile-drawer__heading">
    <span class="site-wordmark">zhou</span>
    <button type="button" class="mobile-drawer__close" data-drawer-close aria-label="关闭菜单">×</button>
  </div>
  <nav class="mobile-drawer__navigation" aria-label="主导航">
    {SITE.navigation.map((item) => (
      <a href={item.href} data-drawer-link aria-current={isCurrentNavigationRoute(item.href, currentPath) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <ThemeSwitcher />
  <a class="mobile-drawer__github" href={SITE.githubUrl} rel="me external" data-drawer-link>GitHub</a>
</aside>
