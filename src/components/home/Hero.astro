---
import { SITE } from '@/config/site';
import { PUBLIC_ROUTES } from '@/domain/routes';
---

<section class="home-card home-hero" data-home-section="hero" aria-labelledby="home-hero-title">
  <div class="home-hero__eyebrow"><span class="home-status-dot" aria-hidden="true"></span>AI 应用开发</div>
  <h1 id="home-hero-title">探索技术边界，让 AI 真正进入业务。</h1>
  <p class="home-hero__role">AI 应用开发者</p>
  <p class="home-hero__summary">
    将 AI 工作流、Agent、知识系统与自动化能力，沉淀为可验证、可运行的应用。
  </p>
  <div class="home-actions" aria-label="首页操作">
    <a class="home-button home-button--primary" data-home-primary-cta href={SITE.githubUrl} rel="me external">
      访问 GitHub
    </a>
    <a class="home-button" data-home-secondary-cta href={PUBLIC_ROUTES.projects}>查看项目</a>
  </div>
</section>
