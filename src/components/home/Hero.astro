---
import type { PublicContact } from '@/domain/content-schema';
import { PUBLIC_ROUTES } from '@/domain/routes';

interface Props {
  eyebrow: string;
  title: string;
  role: string;
  summary: string;
  primaryContact: PublicContact;
}

const { eyebrow, title, role, summary, primaryContact } = Astro.props;
---

<section class="home-card home-hero" data-home-section="hero" aria-labelledby="home-hero-title">
  <div class="home-hero__eyebrow"><span class="home-status-dot" aria-hidden="true"></span>{eyebrow}</div>
  <h1 id="home-hero-title">{title}</h1>
  <p class="home-hero__role">{role}</p>
  <p class="home-hero__summary">{summary}</p>
  <div class="home-actions" aria-label="首页操作">
    <a class="home-button home-button--primary" data-home-primary-cta href={primaryContact.href} rel="me external">
      {primaryContact.label}
    </a>
    <a class="home-button" data-home-secondary-cta href={PUBLIC_ROUTES.projects}>查看项目</a>
  </div>
</section>
