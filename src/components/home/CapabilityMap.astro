---
interface Props {
  capabilities: readonly string[];
}

const { capabilities } = Astro.props;
---

<section class="home-card home-capabilities" data-home-section="capability-map" aria-labelledby="capability-map-title">
  <header class="home-section-heading">
    <p class="home-kicker">AI 能力地图</p>
    <h2 id="capability-map-title">面向应用落地的能力组合</h2>
  </header>
  <ul class="home-capability-list">
    {capabilities.map((capability) => <li>{capability}</li>)}
  </ul>
</section>
