---
const steps = ['发现业务问题', '验证应用场景', '制作可运行原型', '集成现有流程', '评估并持续迭代'];
---

<section class="home-card home-delivery" data-home-section="delivery-method" aria-labelledby="delivery-method-title">
  <header class="home-section-heading">
    <p class="home-kicker">企业 AI 交付方法</p>
    <h2 id="delivery-method-title">以可运行的原型推进决策</h2>
  </header>
  <ol class="home-delivery-list">
    {steps.map((step, index) => <li><span aria-hidden="true">0{index + 1}</span>{step}</li>)}
  </ol>
</section>
