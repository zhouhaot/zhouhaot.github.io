---
import type { PublicContact } from '@/domain/content-schema';

interface Props {
  currentStatus: string;
  primaryContact: PublicContact;
}

const { currentStatus, primaryContact } = Astro.props;
---

<section
  class="home-card home-current-status"
  data-home-section="current-status"
  aria-labelledby="current-status-title"
>
  <header class="home-section-heading">
    <p class="home-kicker">当前状态与联系</p>
    <h2 id="current-status-title">{currentStatus}</h2>
  </header>
  <p>欢迎通过 GitHub 了解公开代码与持续更新的工作。</p>
  <a class="home-text-link" href={primaryContact.href} rel="me external"
    >{primaryContact.label} <span aria-hidden="true">→</span></a
  >
</section>
