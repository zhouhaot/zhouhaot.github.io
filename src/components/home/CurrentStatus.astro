---
import { SITE } from '@/config/site';
import { PUBLIC_PROFILE } from '@/domain/public-profile';
---

<section
  class="home-card home-current-status"
  data-home-section="current-status"
  aria-labelledby="current-status-title"
>
  <header class="home-section-heading">
    <p class="home-kicker">当前状态与联系</p>
    <h2 id="current-status-title">{PUBLIC_PROFILE.currentStatus}</h2>
  </header>
  <p>欢迎通过 GitHub 了解公开代码与持续更新的工作。</p>
  <a class="home-text-link" href={SITE.githubUrl} rel="me external">访问 GitHub <span aria-hidden="true">→</span></a>
</section>
