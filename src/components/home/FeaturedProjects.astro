---
import type { CollectionEntry } from 'astro:content';
import EmptyState from '@/components/EmptyState.astro';
import { workRoute } from '@/domain/routes';

interface Props {
  entries: CollectionEntry<'works'>[];
}

const { entries } = Astro.props;
---

<section
  class="home-card home-featured"
  data-home-section="featured-works"
  aria-labelledby="featured-works-title"
>
  <header class="home-section-heading">
    <p class="home-kicker">精选作品</p>
    <h2 id="featured-works-title">从问题到可验证的应用</h2>
  </header>
  {
    entries.length > 0 ? (
      <div class="home-content-list">
        {entries.map((entry) => (
          <article class="home-content-card" data-home-content-card data-content-collection="works">
            <p class="home-content-card__meta">{entry.data.status}</p>
            <h3>
              <a href={workRoute(entry.id)}>{entry.data.title}</a>
            </h3>
            <p>{entry.data.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <EmptyState collection="works" title="精选作品将随已公开案例更新" description="目前没有可公开展示的作品案例。" />
    )
  }
</section>
