---
interface Props {
  title: string;
  description: string;
  collection?: 'work' | 'lab' | 'notes' | 'portfolio';
}

const { title, description, collection } = Astro.props;
---

<div class="empty-state" data-empty-state data-empty-collection={collection}>
  <strong>{title}</strong>
  <p>{description}</p>
</div>
