---
import { SITE } from '@/config/site';
import { canonicalUrl, jsonLdScript, pageStructuredData, type SeoPageKind } from '@/domain/seo';
import { getSiteProfile } from '@/domain/public-profile.server';
import { themeInitializationScript } from '@/scripts/theme-init';
import SiteHeader from '@/components/SiteHeader.astro';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/components.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  seoKind?: SeoPageKind;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  seoKind = 'home',
  noindex = false,
} = Astro.props;
const canonical = canonicalUrl(canonicalPath);
const structuredData = pageStructuredData({ kind: seoKind, title, description, path: canonicalPath });
const profile = await getSiteProfile();
const primaryContact = profile.contacts[0];
if (!primaryContact) throw new Error('Site profile requires a primary public contact.');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <meta name="theme-color" content="#f7f8fa" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={jsonLdScript(structuredData)} />
    <script is:inline set:html={themeInitializationScript} />
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">跳到主要内容</a>
      <SiteHeader primaryContact={primaryContact} />
      <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
