{
  "name": "zhou-portfolio",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint js/ themes/ admin/ scripts/ src/ tests/ e2e/",
    "format:check": "prettier --check \"src/**/*.{astro,ts,md,mdx,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"*.{js,ts,json}\" \".github/**/*.{yml,yaml}\"",
    "format": "prettier --write \"src/**/*.{astro,ts,md,mdx,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"*.{js,ts,json}\" \".github/**/*.{yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:production": "node scripts/production-audit.mjs dist"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/semver": "7.7.1",
    "@typescript-eslint/scope-manager": "8.55.0",
    "dompurify": "3.4.12",
    "eslint": "9.38.0",
    "eslint-plugin-astro": "1.6.0",
    "jsdom": "26.1.0",
    "marked": "15.0.12",
    "prettier": "3.8.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "4.1.10"
  }
}
