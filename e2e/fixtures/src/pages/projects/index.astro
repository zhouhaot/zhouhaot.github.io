---
import BaseLayout from '../../../../../src/layouts/BaseLayout.astro';
import '../../../../../src/styles/projects.css';
import { works } from '../../data';
---
<BaseLayout title="[QA fixture] works">
  <section class="projects-page">
    <header class="projects-page__header"><h1>[QA fixture] works</h1></header>
    <ul>
      {works.map((work) => (
        <li data-work-card>
          <a href={work.href}>{work.title}</a>
          <p>{work.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
