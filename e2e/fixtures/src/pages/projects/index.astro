---
import ProjectCard from '../../../../../src/components/projects/ProjectCard.astro';
import ProjectFilters from '../../../../../src/components/projects/ProjectFilters.astro';
import BaseLayout from '../../../../../src/layouts/BaseLayout.astro';
import '../../../../../src/styles/projects.css';
import { projects } from '../../data';
---
<BaseLayout title="[QA fixture] projects">
  <section class="projects-page">
    <header class="projects-page__header"><h1>[QA fixture] projects</h1></header>
    <ProjectFilters projects={projects}>
      <div class="projects-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    </ProjectFilters>
  </section>
  <script>import { initProjectFilters } from '../../../../../src/scripts/project-filters'; initProjectFilters();</script>
</BaseLayout>
