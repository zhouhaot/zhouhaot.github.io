---
import BaseLayout from '../../../../../src/layouts/BaseLayout.astro';
import { works } from '../../data';
---
<BaseLayout title="[QA fixture] portfolio">
  <section class="portfolio-page">
    <header class="portfolio-page__header"><h1>[QA fixture] works gallery</h1></header>
    <ul>
      {works.map((work) => (
        <li>
          <a href={work.href}>{work.title}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
